# direnv config for local/remote dev. Copy to .envrc (gitignored), `direnv allow`.
#
# Secrets come from 1Password via fnox (see fnox.toml) — NOT `op inject` anymore.
# Regenerate the gitignored, fnox-derived .env whenever a secret changes:
#     fnox export -f env -o .env
# direnv then loads that derived .env into the shell while you're in this repo.
# (DATABASE_URL is also shell-global via binutils' secrets-sync, so scripts run
# from anywhere still find it.)

dotenv_if_exists .env
