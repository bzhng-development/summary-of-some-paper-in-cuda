# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Rebuilt by `pnpm run content` (scripts/build-paper-graph.ts) — never edit
# by hand. Not committed: it's derived from src/content/papers/** plus
# src/lib/neon-metadata.generated.json, both available at build time.
/src/lib/graph.generated.json

# IMPORTANT: src/lib/neon-metadata.generated.json IS committed. It's the
# cached Neon snapshot the Vercel build relies on (no DB access in CI).
# Refresh with `uv run python scripts/pull-neon-metadata.py` before deploy.
