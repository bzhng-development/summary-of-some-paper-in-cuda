# Built database lives in local_data/ (100MB+ — exceeds github per-file limit).
# Rebuild via `uv run paper-sync` from the committed jsonls + external_papers.db.
# local_data/ also holds scratch snapshots (papers_unified.db, papers_stash3.db, backups).
local_data/

# Legacy top-level paths (kept so older checkouts don't accidentally stage them)
papers.db
papers.db-wal
papers.db-shm

# Local mintlify leftovers
mintlify-ref/

# Per-run build artifacts from paper-fetch (src/paper_pipeline/ingest/hf_daily_papers.py).
# all_scored.json stays tracked (it's the source of truth for scores); relevant.md is a cache.
src/paper_pipeline/ingest/papers_out/relevant.md
src/paper_pipeline/ingest/papers_out/by_score/
__pycache__/

# docs/ is a DERIVED mirror of the canonical paper set in
# paper-graph-ui/src/content/papers/. Regenerate with
# `uv run python -m paper_pipeline.regen.reconcile_docs --apply`. Not committed.
docs/

.vercel

# direnv (secrets injected at runtime; copy .envrc.example -> .envrc)
.envrc

# Machine-local agent tooling state
.claude/

# Vendored clone of the arxiv.py library (has its own .git) — kept local, install via uv instead
arxiv.py/

# Throwaway working dir: one-off scripts, launch helpers, A/B exports, modal run
# outputs. Disposable by convention; large data here belongs in the HF bucket
# (scripts/data_bucket.py), not git. Was accidentally committed — now untracked.
scratch/
