      "id": 39039816,
      "body": "Yes, the value of Momentum or \"Big Mo\" is important to our careers. Great stuff Ryan!",
      "body_json": {
        "type": "doc",
        "attrs": {
          "schemaVersion": "v1"
        },
        "content": [
          {
