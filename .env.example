## Copy to `.env` (this repo already gitignores `.env`). Fill in real values there.

# Shopify proxy config
OPENAI_BASE_URL=https://proxy.shopify.ai/v1
OPENAI_API_KEY=

# Used by throwaway_script/ helpers (Exa search, OpenRouter/Modal tagging). Optional.
EXA_API_KEY=
OPENROUTER_API_KEY=
MODAL_API_KEY=
