# 1Password secret references — SAFE TO COMMIT (pointers, not secrets).
# Resolved at shell entry by .envrc via `op inject`. Sign in: `op signin`.
#
# One-time setup (paste ROTATED values):
#   op item create --category "API Credential" --title "cuda-dev" --vault Private \
#     'OPENAI_API_KEY[password]=...' 'EXA_API_KEY[password]=...' \
#     'OPENROUTER_API_KEY[password]=...' 'MODAL_API_KEY[password]=...'

export OPENAI_API_KEY="op://Private/cuda-dev/OPENAI_API_KEY"
export EXA_API_KEY="op://Private/cuda-dev/EXA_API_KEY"
export OPENROUTER_API_KEY="op://Private/cuda-dev/OPENROUTER_API_KEY"
export MODAL_API_KEY="op://Private/cuda-dev/MODAL_API_KEY"

# Non-secret config:
export OPENAI_BASE_URL="${OPENAI_BASE_URL:-https://proxy.shopify.ai/v1}"
